# LLM Provider: "ollama" (local) or "groq" (cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Groq Cloud API (Required when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=60

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# MySQL Database
MYSQL_URL=mysql+pymysql://memorygraph:memorygraph_secret@localhost:3306/memorygraph
MYSQL_ENABLED=false

# Redis Cache & Session Memory
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_HISTORY_LIMIT=20

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me
NEO4J_ENABLED=false

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
GRAPH_HOPS=2
MAX_UPLOAD_MB=25
UPLOAD_DIR=./data/uploads
API_URL=http://localhost:8000
LOG_LEVEL=INFO
